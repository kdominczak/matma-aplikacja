# Klucz Groq do testów korepetytora AI w `npm run dev` (skopiuj do `.env.local`).
# Działa WYŁĄCZNIE w trybie deweloperskim – build produkcyjny go pomija, żeby nie trafił do APK.
# Uczniowie wklejają własny darmowy klucz w aplikacji (Korepetytor AI → „Połącz”), zapisywany tylko na ich urządzeniu.
# Klucz założysz na https://console.groq.com/keys
NEXT_PUBLIC_GROQ_API_KEY=gsk_...

# Ranking (Supabase). Oba klucze są publiczne z założenia – dane chroni RLS (supabase/migrations).
# Panel Supabase → Project Settings → API. Po zmianie przebuduj aplikację.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<klucz-anon>
