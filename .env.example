# Supabase: ranking, konto, kopia postępu, korepetytor AI (funkcja `ai`) i Premium.
# Oba klucze są publiczne z założenia – dane chroni RLS (supabase/migrations).
# Panel Supabase → Project Settings → API. Po zmianie przebuduj aplikację.
# Klucz Groq NIE trafia do aplikacji – jest tylko w sekretach funkcji (`supabase secrets set GROQ_API_KEY=...`).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<klucz-anon>

# Zakupy Premium (RevenueCat → Project settings → API keys → klucz aplikacji Google Play, zaczyna się od goog_).
# Publiczny klucz SDK – może być w aplikacji. Bez niego ekran Premium pokazuje ceny informacyjnie, bez zakupu.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
